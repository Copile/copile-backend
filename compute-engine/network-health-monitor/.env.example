# Service Configuration
PORT=3002
NODE_ENV=development

# Solana RPC Endpoints
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JITO_RPC_URL=https://jito-api.mainnet-beta.solana.com
GENESYS_RPC_URL=https://your-genesys-endpoint.solana.com

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
PUBSUB_TOPIC=network-alerts

# Alert Thresholds (optional - defaults in code)
MAX_BLOCK_TIME=800
MIN_TPS=1000
MAX_LATENCY=500
MIN_VALIDATOR_COUNT=1000
MAX_CONGESTION=0.8

# Monitoring Configuration
PROMETHEUS_ENABLED=true
WEBSOCKET_ENABLED=true
HISTORICAL_DATA_RETENTION_DAYS=7

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json 